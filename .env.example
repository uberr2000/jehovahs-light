# Listen port for Next.js / standalone server.js.
# Set this on the server .env only. Never add --port to package.json start.
PORT=3000

# MySQL for Drizzle (src/lib/db + drizzle.config.ts). Host defaults to localhost.
DB_HOST=localhost
DB_USER=jehovahs_light
DB_PASSWORD=your_password
DB_NAME=jehovahs_light
# Public site root for Share v1 social hrefs (LINE / Facebook / X / WhatsApp)
# and for metadataBase / og:url / og:image / twitter:image. Must be a real
# https URL. Empty / non-https / placeholders (your-domain.com,
# example.invalid, example.com) are treated as unset — no Host-header
# fallback. SSR share hrefs stay neutral; the client fills from
# window.location.origin. localhost / 127.0.0.1 is ok for dev.
# Email `mailto:` is assigned after mount (Cloudflare Email Obfuscation rewrites SSR).
# Query / hash / GPS / tracking params are stripped. Never put PII here.
NEXT_PUBLIC_APP_URL=https://your-domain.com
